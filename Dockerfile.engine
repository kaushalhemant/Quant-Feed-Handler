# Stage 1: Build C++20 Release Binary with Native Optimizations
FROM gcc:12-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY CMakeLists.txt ./
COPY include ./include
COPY src ./src

RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
RUN cmake --build build --config Release

# Stage 2: Minimal Distroless / Debian Runtime Image
FROM debian:bookworm-slim AS runtime

RUN useradd -m -u 1000 quantuser
WORKDIR /app

COPY --from=builder /workspace/build/stream_server /app/stream_server
COPY --from=builder /workspace/build/feed_handler /app/feed_handler
COPY --from=builder /workspace/build/mock_exchange /app/mock_exchange
COPY examples /app/examples

USER quantuser

EXPOSE 9090
EXPOSE 12345/udp

ENTRYPOINT ["/app/stream_server"]
